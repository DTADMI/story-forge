#!/usr/bin/env bash
set -euo pipefail

echo "==> StoryForge pre-commit checks"
echo ""

# Each check fails the commit if it doesn't pass.
# Run 'pnpm run-all-checks' locally to verify before committing.

echo "-> Formatting..."
pnpm format:check
echo "   OK"

echo "-> Generating Prisma client..."
pnpm exec prisma generate --schema prisma/schema.prisma > /dev/null 2>&1
echo "   OK"

echo "-> Linting..."
pnpm lint
echo "   OK"

echo "-> Typecheck..."
pnpm typecheck
echo "   OK"

echo "-> Testing..."
pnpm test:run
echo "   OK"

echo "-> Supabase security guardrails..."
pnpm check:supabase-security
echo "   OK"

echo "-> Building..."
pnpm build > /dev/null 2>&1
echo "   OK"

echo ""
echo "-> All pre-commit checks passed"
