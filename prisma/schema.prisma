// Prisma schema for StoryForge

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum VisibilityScope {
  PRIVATE
  FRIENDS
  PUBLIC_AUTHENTICATED
  PUBLIC_ANYONE
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  // Local auth
  passwordHash  String?

  // Profile
  username      String?  @unique
  bio           String?
  website       String?
  settings      Json?
  subscriptionStatus   String?
  subscriptionExpiresAt DateTime?

  // Role-based access
  role             String @default("reader")
  subscriptionTier String @default("free")

  collaborations ProjectCollaborator[]

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  inkPot        InkPot?
  inkTx         InkTx[]
  goals         Goal[]
  progressLog   ProgressLog[]
  badges        UserBadge[]
  followers     Follow[] @relation("followers")
  following     Follow[] @relation("following")
  groups        GroupMember[]
  characters    Character[]
  locations     Location[]
  timelineEvents TimelineEvent[]
  dialogues     Dialogue[]
  encyclopediaEntries EncyclopediaEntry[]
  organizations Organization[]
  species      Species[]
  calendars    Calendar[]
  eras         Era[]
  comments      Comment[]
  versions      ProjectVersion[]
  activities    Activity[]
  sentMessages     Message[]  @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  notifications    Notification[]

  blockedUsers UserBlock[] @relation("Blocker")
  blockedBy    UserBlock[] @relation("Blocked")
  favorites    ProjectFavorite[]
  votes        ProjectVote[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  title         String
  description   String?
  content       String?  @db.Text
  genre         String?
  isPublic      Boolean  @default(false)
  wordCount     Int      @default(0)
  defaultScope  VisibilityScope @default(PRIVATE)
  panelCount    Int      @default(0)
  settings      Json?

  collaborators ProjectCollaborator[]

  characters    Character[]
  locations     Location[]
  timelineEvents TimelineEvent[]
  dialogues     Dialogue[]
  encyclopediaEntries EncyclopediaEntry[]
  organizations Organization[]
  species      Species[]
  calendars    Calendar[]
  eras         Era[]
  comments      Comment[]
  versions      ProjectVersion[]

  favoritedBy        ProjectFavorite[]
  votes              ProjectVote[]
  competitionEntries CompetitionEntry[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String   @default("editor")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// Gamification models
model InkPot {
  id      String @id @default(cuid())
  user    User   @relation(fields: [userId], references: [id])
  userId  String @unique
  balance Int    @default(0)

  transactions InkTx[]
}

model InkTx {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  pot       InkPot?  @relation(fields: [potId], references: [id])
  potId     String?
  amount    Int
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Goal {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String   // e.g., 'words_per_day'
  target    Int      // e.g., 500
  cadence   String   // 'daily' | 'weekly'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress  ProgressLog[]
}

model ProgressLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  goal      Goal?    @relation(fields: [goalId], references: [id])
  goalId    String?
  value     Int
  timestamp DateTime @default(now())
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  imageUrl    String?
  threshold   Int      // word count or other metric
  type        String   // 'total_words' | 'streak' | etc
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  badgeId   String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Character {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  bio         String?
  traits      String?
  quirks      String?
  imageUrl    String?
  metadata    Json?    // For flexible properties
  isShared             Boolean  @default(false)
  sharedFromProjectId  String?

  timelineEvents TimelineEvent[]
  sourceRelationships CharacterRelationship[] @relation("SourceRelationships")
  targetRelationships CharacterRelationship[] @relation("TargetRelationships")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  description String?
  mapUrl      String?
  metadata    Json?
  isShared             Boolean  @default(false)
  sharedFromProjectId  String?

  timelineEvents TimelineEvent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimelineEvent {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  title       String
  date        String?  // Flexible date format
  description String?
  isShared             Boolean  @default(false)
  sharedFromProjectId  String?
   
  characters  Character[]
  locations   Location[]
  
  dialogue    Dialogue? @relation(fields: [dialogueId], references: [id])
  dialogueId  String?

  era         Era?     @relation(fields: [eraId], references: [id])
  eraId       String?
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Dialogue {
  id          String   @id @default(cuid())
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  title       String?  // Optional title for the dialogue scene
  content     Json     // Structured list of speakers and lines
   
  timelineEvents TimelineEvent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EncyclopediaEntry {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  category    String   // research, calendar, magic, fauna, flora, culture, item, system, language, religion, philosophy
  title       String
  content     String   @db.Text
  metadata    Json?
  imageUrl    String?
  references  String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, category])
}

// Organizations / Factions
model Organization {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  type        String?
  description String?  @db.Text
  goals       String?  @db.Text
  imageUrl    String?
  metadata    Json?
  isShared             Boolean  @default(false)
  sharedFromProjectId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Species / Races
model Species {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  description String?  @db.Text
  appearance  String?  @db.Text
  traits      String?
  lifespan    String?
  homeland    String?
  imageUrl    String?
  metadata    Json?
  isShared             Boolean  @default(false)
  sharedFromProjectId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Character relationships (manual, typed)
model CharacterRelationship {
  id           String   @id @default(cuid())
  character    Character @relation("SourceRelationships", fields: [characterId], references: [id])
  characterId  String
  related      Character @relation("TargetRelationships", fields: [relatedId], references: [id])
  relatedId    String
  type         String
  description  String?
  createdAt    DateTime @default(now())

  @@unique([characterId, relatedId, type])
  @@index([characterId])
  @@index([relatedId])
}

// Eras / Periods for timeline grouping
model Era {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  description String?  @db.Text
  startDate   String?
  endDate     String?
  color       String?
  sortOrder   Int      @default(0)
  events      TimelineEvent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, sortOrder])
}

// Calendar system
model Calendar {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?
  name        String
  weekLength  Int      @default(7)
  months      CalendarMonth[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CalendarMonth {
  id          String   @id @default(cuid())
  calendar    Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId  String
  name        String
  days        Int      @default(30)
  orderIndex  Int      @default(0)
  description String?

  @@index([calendarId])
}

// Activity feed
model Activity {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  type       String   // project_created, project_published, badge_earned, streak_milestone, goal_complete, follow_gained
  entityId   String?  // ID of the related entity (project, badge, etc.)
  entityType String?  // project, badge, goal
  metadata   Json?    // { title, wordCount, badgeName, streakDays, etc. }
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  type       String   // comment, cheer, follow, badge, message, group_invite
  title      String
  body       String?
  entityId   String?
  entityType String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read, createdAt])
}

// Project comments
model Comment {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  parentId  String?  // For threaded replies
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
}

// Project version history
model ProjectVersion {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String   @db.Text
  wordCount Int      @default(0)
  label     String?  // Optional user-provided version label
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// Social follow model
model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("following", fields: [followerId], references: [id])
  followerId  String
  followee    User     @relation("followers", fields: [followeeId], references: [id])
  followeeId  String
  createdAt   DateTime @default(now())

  @@unique([followerId, followeeId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPrivate   Boolean  @default(false)
  
  members     GroupMember[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupMember {
  id        String   @id @default(cuid())
  group     Group    @relation(fields: [groupId], references: [id])
  groupId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String   @default("member") // "admin" | "member"
  
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Message {
  id         String   @id @default(cuid())
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, read, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockerId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model ProjectFavorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model ProjectVote {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  value     Int
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model Competition {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  type        String
  genre       String?
  minWords    Int      @default(0)
  maxWords    Int?
  startDate   DateTime
  endDate     DateTime
  status      String   @default("upcoming")
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entries     CompetitionEntry[]
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competition   Competition @relation(fields: [competitionId], references: [id])
  competitionId String
  project       Project     @relation(fields: [projectId], references: [id])
  projectId     String
  userId        String
  createdAt     DateTime    @default(now())

  @@unique([competitionId, projectId])
}
