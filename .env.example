# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase Postgres via Prisma)
# Vercel: Set in Project Settings → Environment Variables
# Use the Supabase dashboard → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=

# Upstash Redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# OpenRouter AI
OPENROUTER_API_KEY=

# Resend Email
RESEND_API_KEY=

# Neo4j Graph Database
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_LIFETIME=

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Deployment
# All variables above must be set in Vercel Project Settings → Environment Variables.
# Critical for build: DATABASE_URL (Prisma generate + Next.js build)
# Critical for runtime: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, DATABASE_URL
# The build WILL FAIL if DATABASE_URL is not set.

# Shared (AdSense / Stripe — cross-project consistency)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX
