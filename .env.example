# StoryForge — Environment Variables
# Copy this to .env.local and fill in the values

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Database (Supabase Postgres via Prisma) ──
# Use the Supabase Session Pooler connection string (port 6543)
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# For Prisma migrations (uses port 5432, direct connection)
# DIRECT_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Upstash Redis (caching, feature flags, rate limiting) ──
UPSTASH_REDIS_URL=https://your-project.upstash.io
UPSTASH_REDIS_TOKEN=your-token

# ── Neo4j (graph database — optional, for galaxy visualization) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── OpenRouter AI (optional — for AI-assisted writing) ──
OPENROUTER_API_KEY=sk-or-v1-your-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (optional — for payments) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_YEARLY=price_...

# ── Feature Flags (set to true/1 to enable) ──
# NEXT_PUBLIC_FEATURE_PAYMENTS=false
# NEXT_PUBLIC_FEATURE_AI_ASSIST=false
# NEXT_PUBLIC_FEATURE_AI_WRITING_SUGGESTIONS=false
# NEXT_PUBLIC_FEATURE_AI_CHARACTER=false
# NEXT_PUBLIC_FEATURE_AI_PLOT=false
# NEXT_PUBLIC_FEATURE_AI_STYLE=false
# NEXT_PUBLIC_FEATURE_AI_RESEARCH=false
# NEXT_PUBLIC_FEATURE_PROJECTS_V2=false
# NEXT_PUBLIC_FEATURE_WELLBEING=true
# NEXT_PUBLIC_FEATURE_DESIGN_SYSTEM_V2=true

# ── Next.js ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-random-secret
