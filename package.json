{
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.26.0"
  },
  "pnpm": {
    "overrides": {
      "@prisma/client": "7.2.0",
      "@prisma/adapter-pg": "7.2.0",
      "@prisma/internals": "7.2.0",
      "prisma": "7.2.0"
    },
    "ignoredBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ],
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "build": "pnpm -C web build",
    "test": "pnpm -C web test:run",
    "vercel-build": "pnpm -C web install --frozen-lockfile && pnpm -C web exec prisma generate --schema ../prisma/schema.prisma && pnpm -C web build && node ./scripts/vercel-output-compat.mjs",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:stop": "docker compose -f docker-compose.local.yml stop",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "dev:local": "pnpm docker:up && pnpm supabase:start && pnpm dev"
  },
  "dependencies": {
    "next": "^16.2.2"
  },
  "devDependencies": {
    "@prisma/client": "^7.2.0",
    "@prisma/internals": "^7.2.0",
    "@types/node": "^25.5.0",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
