{
  "name": "story-forge",
  "private": true,
  "version": "0.4.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm exec prisma generate --schema prisma/schema.prisma && next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:all": "pnpm typecheck && pnpm test:run",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate dev",
    "db:studio": "pnpm prisma studio",
    "seed": "node ./scripts/seed.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css}\"",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:stop": "docker compose -f docker-compose.local.yml stop",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "dev:local": "pnpm docker:up && pnpm supabase:start && pnpm dev",
    "verify:integration": "powershell -ExecutionPolicy Bypass -File scripts/verify-integration.ps1",
    "verify:flags": "powershell -ExecutionPolicy Bypass -File scripts/verify-feature-flags.ps1",
    "verify:pipelines": "powershell -ExecutionPolicy Bypass -File scripts/verify-pipelines.ps1",
    "verify:all": "pnpm verify:integration && pnpm verify:flags && pnpm verify:pipelines",
    "verify": "node scripts/verify.mjs --all",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "run-all-checks": "pnpm format:check && pnpm exec prisma generate --schema prisma/schema.prisma && pnpm lint && pnpm typecheck && pnpm test:run && pnpm check:supabase-security && pnpm build && pnpm verify"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client-runtime-utils": "^7.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-query": "^5.100.1",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "neo4j-driver": "^5.28.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^4.0.0",
    "server-only": "^0.0.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@prisma/client": "^7.2.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "prisma": "^7.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.2",
    "vitest": "^2.1.9"
  }
}
