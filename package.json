{
  "name": "story-forge",
  "private": true,
  "version": "0.4.0",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm exec prisma generate --schema prisma/schema.prisma && next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:all": "pnpm typecheck && pnpm test:run",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate dev",
    "db:studio": "pnpm prisma studio",
    "seed": "node ./scripts/seed.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css}\"",
    "docker:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:down": "docker compose -f docker-compose.local.yml down",
    "docker:stop": "docker compose -f docker-compose.local.yml stop",
    "docker:logs": "docker compose -f docker-compose.local.yml logs -f",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "dev:local": "pnpm docker:up && pnpm supabase:start && pnpm dev",
    "verify:integration": "powershell -ExecutionPolicy Bypass -File scripts/verify-integration.ps1",
    "verify:flags": "powershell -ExecutionPolicy Bypass -File scripts/verify-feature-flags.ps1",
    "verify:pipelines": "powershell -ExecutionPolicy Bypass -File scripts/verify-pipelines.ps1",
    "verify:all": "pnpm verify:integration && pnpm verify:flags && pnpm verify:pipelines",
    "verify": "node scripts/verify.mjs --all",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "run-all-checks": "pnpm format:check && pnpm exec prisma generate --schema prisma/schema.prisma && pnpm lint && pnpm typecheck && pnpm test:run && pnpm check:supabase-security && pnpm build && pnpm verify"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^3.29.0",
    "@tiptap/extension-collaboration": "^3.29.0",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lib0": "^0.2.117",
    "lucide-react": "^0.562.0",
    "neo4j-driver": "^5.28.3",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^4.8.0",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@prisma/client": "^7.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "3.2.4"
  }
}
